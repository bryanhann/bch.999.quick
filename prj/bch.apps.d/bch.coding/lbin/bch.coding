#/usr/bin/env bash
$BH1
real=$(readlink ${BASH_SOURCE[0]})
[ ! -f $real.d/$1 ] && {
    for name in $(ls $real.d); do
        echo "    try: $(basename $real) $name"
    done
    exit
}

$real.d/$@
exit

bch_coding () { 
    local cmd=$1
    shift
    [ ! x$cmd == x  ] && source $real.d/$cmd "$@"
}
bch_coding .init 
bch_coding .env 
bch_coding .bch0 
bch_coding .init 
bch_coding .fds
bch_coding .exec $*

