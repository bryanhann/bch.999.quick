cd $(dirname $0)
$BH1
cd $(dirname $0) > /dev/null
bh0 bch lbin4repo $PWD

process () {
    real=$1
    link=~/.local/bin/$(basename $1)
    rm $link 2> /dev/null
    ln -s $real $link
    echo installed $link 
}
for lbin in $(find $PWD/prj -name lbin); do
    for name in $(ls $lbin); do
        target=$lbin/$name
        [ -f $target ] && process $target
    done
done

