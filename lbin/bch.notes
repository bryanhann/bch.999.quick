#!/usr/bin/env bash

[ ! ${BASH_SOURCE[0]} == $0 ] &&  echo this must be called, not sourced
[ ! ${BASH_SOURCE[0]} == $0 ] &&  return

$BH1

this=$(0resolve $0)
name=$(basename $this)
root=$(dirname $(dirname $this))
prj=$root/prj
app=$root/prj/bch.apps.d/$name/$name

[ -f $this.d/$1 ] && { $this.d/$@;  exit $? ; }

uv run --project $prj $app "$@"
